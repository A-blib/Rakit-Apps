<?xml version="1.0" encoding="utf-8"?>
<!-- Layar sebelumnya memudar halus dengan perbesaran mikro (fade-through). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/slide_up_duration_ms"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <scale
        android:fromXScale="1.0"
        android:toXScale="1.04"
        android:fromYScale="1.0"
        android:toYScale="1.04"
        android:pivotX="50%"
        android:pivotY="50%" />
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.0" />
</set>
