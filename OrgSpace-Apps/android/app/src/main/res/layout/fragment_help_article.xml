<?xml version="1.0" encoding="utf-8"?>
<!--
    Artikel Panduan untuk satu aturan pengecekan (alur-fitur-upload.md bagian 5.11): kenapa ini masalah,
    contoh salah ✕ dan benar ✓, cara memperbaiki, tips mencegah. Isinya dari server.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/help_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                android:paddingVertical="@dimen/space_6">

                <TextView
                    android:id="@+id/code"
                    style="@style/Widget.App.Badge" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:textAppearance="@style/TextAppearance.App.Headline" />

                <TextView
                    style="@style/Widget.App.SectionTitle"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="@string/help_why" />

                <TextView
                    android:id="@+id/why"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textAppearance="@style/TextAppearance.App.Body" />

                <TextView
                    android:id="@+id/wrong_title"
                    style="@style/Widget.App.SectionTitle"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="@string/help_wrong"
                    android:textColor="@color/color_error" />

                <TextView
                    android:id="@+id/wrong"
                    style="@style/Widget.App.CodeBlock" />

                <TextView
                    android:id="@+id/right_title"
                    style="@style/Widget.App.SectionTitle"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="@string/help_right"
                    android:textColor="@color/color_success" />

                <TextView
                    android:id="@+id/right"
                    style="@style/Widget.App.CodeBlock" />

                <TextView
                    style="@style/Widget.App.SectionTitle"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="@string/help_fix" />

                <TextView
                    android:id="@+id/fix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textAppearance="@style/TextAppearance.App.Body" />

                <TextView
                    android:id="@+id/tips_title"
                    style="@style/Widget.App.SectionTitle"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="@string/help_tips" />

                <TextView
                    android:id="@+id/tips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textAppearance="@style/TextAppearance.App.Body" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.aris.templateapp.ui.common.StateView
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
