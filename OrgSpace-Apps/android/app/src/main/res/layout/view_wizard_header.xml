<?xml version="1.0" encoding="utf-8"?>
<!--
    Zona atas wizard Upload (alur-fitur-upload.md bagian 3.2 & 3.3): tombol ✕, judul langkah, "Langkah X dari 6",
    dan garis kemajuan. Wizard terbuka layar penuh tanpa bottom navigation.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        tools:ignore="RtlSymmetry">

        <ImageButton
            android:id="@+id/close_button"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/space_2"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_close_wizard"
            android:src="@drawable/ic_close" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <TextView
            android:id="@+id/step"
            style="@style/Widget.App.SectionTitle"
            android:layout_marginStart="@dimen/space_2" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/step_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="6"
        app:indicatorColor="@color/color_foreground"
        app:indicatorTrackGapSize="0dp"
        app:trackColor="@color/color_border"
        app:trackStopIndicatorSize="0dp"
        app:trackThickness="@dimen/border_width_selected" />
</LinearLayout>
