<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu folder mode kisi 2 kolom di "Template Anda" (ala Google Drive):
     Header (ikon folder kecil, nama, jumlah, menu ⋮) + ilustrasi siluet folder besar di badan kartu. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: ikon folder kecil + nama & jumlah template + tombol menu ⋮ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_1"
            android:paddingBottom="@dimen/space_1">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_folder_filled"
                app:tint="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_marginEnd="@dimen/space_1"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.App.Label"
                    android:textColor="@color/color_muted" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/menu_button"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_folder_menu"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/color_muted" />
        </LinearLayout>

        <!-- Badan kartu: gambar siluet ilustrasi folder ala Google Drive -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="@dimen/space_1"
            android:layout_marginBottom="@dimen/space_3">

            <ImageView
                android:id="@+id/folder_illustration"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_folder_drive_illustration" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
