<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_surface"
        app:navigationIcon="@drawable/ic_close"
        app:title="@string/custom_domain_title"
        app:titleTextAppearance="@style/TextAppearance.App.Title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                android:paddingTop="@dimen/space_4"
                android:paddingBottom="@dimen/space_8">

                <!-- Header Intro -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_badge"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_language"
                        app:tint="@color/color_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_domain_title"
                            android:textAppearance="@style/TextAppearance.App.Title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/custom_domain_subtitle"
                            android:textAppearance="@style/TextAppearance.App.BodySmall"
                            android:textColor="@color/color_muted" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 1. Card Alamat Default -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_default_domain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    app:cardCornerRadius="@dimen/radius_medium"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_4">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/custom_domain_default_label"
                                android:textAppearance="@style/TextAppearance.App.Label"
                                android:textColor="@color/color_muted" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_success"
                                android:paddingHorizontal="@dimen/space_2"
                                android:paddingVertical="2dp"
                                android:text="Aktif"
                                android:textAppearance="@style/TextAppearance.App.Label"
                                android:textColor="@color/color_success"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/text_default_subdomain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/color_foreground"
                            android:textStyle="bold"
                            tools:text="https://osis-smansa.orgspace.site" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Card Domain Sendiri -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_custom_domain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    app:cardCornerRadius="@dimen/radius_medium"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_4">

                        <!-- Title & Status Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/custom_domain_custom_label"
                                android:textAppearance="@style/TextAppearance.App.Title" />

                            <TextView
                                android:id="@+id/badge_custom_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge"
                                android:paddingHorizontal="@dimen/space_2"
                                android:paddingVertical="2dp"
                                android:text="Belum Ada"
                                android:textAppearance="@style/TextAppearance.App.Label"
                                android:textColor="@color/color_muted"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- STATE 1: Belum punya custom domain -->
                        <LinearLayout
                            android:id="@+id/layout_no_domain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sambungkan domain yang kamu beli dari registrar (misal webUser.my.id, osis.id, atau organisasi.com) agar pengunjung langsung mengakses website lewat alamatmu sendiri."
                                android:textAppearance="@style/TextAppearance.App.BodySmall"
                                android:textColor="@color/color_muted" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/input_domain_layout"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:hint="@string/custom_domain_hint"
                                app:boxStrokeColor="@color/color_primary">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/input_domain_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textUri"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <Button
                                android:id="@+id/btn_connect_domain"
                                style="@style/Widget.App.Button"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/custom_domain_connect_btn"
                                app:icon="@drawable/ic_link" />
                        </LinearLayout>

                        <!-- STATE 2: Pending (Menunggu DNS) -->
                        <LinearLayout
                            android:id="@+id/layout_pending_domain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:id="@+id/text_pending_hostname"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.App.Body"
                                android:textColor="@color/color_primary"
                                android:textStyle="bold"
                                tools:text="www.osissmansa.my.id" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:text="@string/custom_domain_dns_setup_desc"
                                android:textAppearance="@style/TextAppearance.App.BodySmall"
                                android:textColor="@color/color_muted" />

                            <!-- Instruksi DNS 1: Target CNAME / A -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                app:cardBackgroundColor="@color/color_surface_subtle"
                                app:cardCornerRadius="@dimen/radius_small"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="@dimen/space_3">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/text_target_type_label"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:textAppearance="@style/TextAppearance.App.Label"
                                            android:textColor="@color/color_primary"
                                            tools:text="1. Record CNAME (Host: www)" />

                                        <ImageButton
                                            android:id="@+id/btn_copy_target"
                                            android:layout_width="32dp"
                                            android:layout_height="32dp"
                                            android:background="?attr/selectableItemBackgroundBorderless"
                                            android:contentDescription="Salin nilai target"
                                            android:src="@drawable/ic_content_copy"
                                            app:tint="@color/color_muted" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/text_target_value"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                                        android:textIsSelectable="true"
                                        android:textStyle="bold"
                                        tools:text="custom.orgspace.site" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Instruksi DNS 2: TXT Verifikasi -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                app:cardBackgroundColor="@color/color_surface_subtle"
                                app:cardCornerRadius="@dimen/radius_small"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="@dimen/space_3">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/text_txt_host_label"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:textAppearance="@style/TextAppearance.App.Label"
                                            android:textColor="@color/color_primary"
                                            tools:text="2. Record TXT (Verifikasi)" />

                                        <ImageButton
                                            android:id="@+id/btn_copy_txt"
                                            android:layout_width="32dp"
                                            android:layout_height="32dp"
                                            android:background="?attr/selectableItemBackgroundBorderless"
                                            android:contentDescription="Salin token TXT"
                                            android:src="@drawable/ic_content_copy"
                                            app:tint="@color/color_muted" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/text_txt_host_name"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                                        android:textColor="@color/color_muted"
                                        tools:text="Host: _orgspace-verify.www.osissmansa.my.id" />

                                    <TextView
                                        android:id="@+id/text_txt_value"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                                        android:textIsSelectable="true"
                                        android:textStyle="bold"
                                        tools:text="a8f3b7c2d1e4f5..." />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Error info if any -->
                            <TextView
                                android:id="@+id/text_pending_error"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:background="@drawable/bg_banner_warning"
                                android:padding="@dimen/space_3"
                                android:textAppearance="@style/TextAppearance.App.BodySmall"
                                android:textColor="@color/color_warning"
                                android:visibility="gone"
                                tools:text="Record TXT belum terdeteksi. Silakan coba lagi nanti."
                                tools:visibility="visible" />

                            <Button
                                android:id="@+id/btn_verify_domain"
                                style="@style/Widget.App.Button"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/custom_domain_verify_btn"
                                app:icon="@drawable/ic_check" />

                            <Button
                                android:id="@+id/btn_cancel_domain"
                                style="@style/Widget.App.Button.Text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:text="@string/custom_domain_remove_btn"
                                android:textColor="@color/color_error" />
                        </LinearLayout>

                        <!-- STATE 3: Active (Aktif) -->
                        <LinearLayout
                            android:id="@+id/layout_active_domain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:id="@+id/text_active_domain_url"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.App.Title"
                                android:textColor="@color/color_success"
                                tools:text="https://www.osissmansa.my.id" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:text="Website kamu sudah berhasil terhubung dengan domain ini dan dapat diakses langsung oleh siapa saja di internet."
                                android:textAppearance="@style/TextAppearance.App.BodySmall"
                                android:textColor="@color/color_muted" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/btn_open_active_site"
                                    style="@style/Widget.App.Button"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/custom_domain_open_site"
                                    app:icon="@drawable/ic_web" />

                                <Button
                                    android:id="@+id/btn_copy_active_site"
                                    style="@style/Widget.App.Button.Outlined"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_2"
                                    android:layout_weight="1"
                                    android:text="@string/custom_domain_copy_address"
                                    app:icon="@drawable/ic_link" />
                            </LinearLayout>

                            <Button
                                android:id="@+id/btn_remove_active_domain"
                                style="@style/Widget.App.Button.Text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:text="@string/custom_domain_remove_btn"
                                android:textColor="@color/color_error" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Loading Progress Overlay -->
        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
