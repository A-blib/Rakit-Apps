<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom sheet tombol + di Template Anda (ala Google Drive): "Folder baru", lalu pilihan status yang ditampilkan
    beserta jumlahnya (sebelumnya chip di atas daftar). Teks jumlah diisi dari kode.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_4">

        <TextView
            style="@style/Widget.App.ListGroupTitle"
            android:paddingTop="@dimen/space_2"
            android:text="@string/templates_menu_create" />

        <TextView
            android:id="@+id/new_folder"
            style="@style/Widget.App.ListItem.Text"
            android:text="@string/folder_new"
            app:drawableStartCompat="@drawable/ic_folder" />

        <com.google.android.material.divider.MaterialDivider
            style="@style/Widget.App.Divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2" />

        <TextView
            android:id="@+id/show_title"
            style="@style/Widget.App.ListGroupTitle"
            android:paddingTop="@dimen/space_4"
            android:text="@string/templates_menu_show" />

        <RadioGroup
            android:id="@+id/status_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_4">

            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/status_all" style="@style/Widget.App.RadioButton" />
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/status_published" style="@style/Widget.App.RadioButton" />
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/status_needs_fix" style="@style/Widget.App.RadioButton" />
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/status_checking" style="@style/Widget.App.RadioButton" />
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/status_draft" style="@style/Widget.App.RadioButton" />
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/status_disabled" style="@style/Widget.App.RadioButton" />
        </RadioGroup>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
