<?xml version="1.0" encoding="utf-8"?>
<!-- Serah terima: pilih Pemilik baru + peran Pemilik lama setelahnya (revisi-fondasi-orgspace.md 4.4). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/org_menu_transfer" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                android:paddingBottom="@dimen/space_8">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/transfer_subtitle"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/color_muted" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="@string/transfer_choose_member"
                    android:textAppearance="@style/TextAppearance.App.Label" />

                <RadioGroup
                    android:id="@+id/member_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2" />

                <TextView
                    android:id="@+id/member_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/transfer_member_required"
                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                    android:textColor="@color/color_error"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="@string/transfer_keep_label"
                    android:textAppearance="@style/TextAppearance.App.Label" />

                <RadioGroup
                    android:id="@+id/keep_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:checkedButton="@id/keep_admin">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/keep_admin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/transfer_keep_admin" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/keep_editor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/transfer_keep_editor" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/keep_leave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/transfer_keep_leave" />
                </RadioGroup>

                <Button
                    android:id="@+id/submit_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="@string/transfer_submit" />
            </LinearLayout>
        </ScrollView>

        <com.aris.templateapp.ui.common.StateView
            android:id="@+id/state_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
