<?xml version="1.0" encoding="utf-8"?>
<!--
    Tab Profil kreator template (alur-provider.md bagian 7), desain ulang 12 Okt 2026 seragam dengan Profil pembuat
    website: kartu identitas (sampul, avatar, nama, badge, bio, portofolio, keahlian, statistik) lalu menu berkelompok.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_8">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Sampul + avatar dalam satu FrameLayout: avatar digambar di atas sampul, separuhnya menumpuk. -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/profile_cover_height"
                            android:background="@drawable/bg_profile_cover" />

                        <!-- Avatar: huruf depan nama di lingkaran kuning bercincin; foto profil (bila ada) digambar di atasnya. -->
                        <FrameLayout
                            android:layout_width="@dimen/profile_avatar_size"
                            android:layout_height="@dimen/profile_avatar_size"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_marginTop="@dimen/profile_avatar_top"
                            android:background="@drawable/bg_profile_avatar"
                            android:padding="@dimen/profile_avatar_ring">

                            <TextView
                                android:id="@+id/avatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textAppearance="@style/TextAppearance.App.Headline"
                                android:textColor="@color/color_on_accent" />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/avatar_photo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle" />
                        </FrameLayout>

                        <!-- Tombol Edit di kanan avatar, tepat di bawah sampul. -->
                        <Button
                            android:id="@+id/edit_button"
                            style="@style/Widget.App.Button.Outlined.Compact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="@dimen/profile_edit_top"
                            android:layout_marginEnd="@dimen/space_4"
                            android:text="@string/profile_edit"
                            app:icon="@drawable/ic_edit_small"
                            app:iconGravity="textStart" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_4"
                        android:paddingBottom="@dimen/space_4">

                        <TextView
                            android:id="@+id/creator_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3"
                            android:textAppearance="@style/TextAppearance.App.Headline" />

                        <TextView
                            android:id="@+id/email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:textAppearance="@style/TextAppearance.App.BodySmall" />

                        <TextView
                            style="@style/Widget.App.Badge"
                            android:layout_marginTop="@dimen/space_3"
                            android:text="@string/profile_badge_provider" />

                        <TextView
                            android:id="@+id/bio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:textAppearance="@style/TextAppearance.App.Body" />

                        <!-- Link portofolio sebagai baris kecil berikon, bukan URL polos. -->
                        <TextView
                            android:id="@+id/portfolio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3"
                            android:autoLink="web"
                            android:drawablePadding="@dimen/space_2"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/touch_target_min"
                            android:textAppearance="@style/TextAppearance.App.BodySmall"
                            android:textColor="@color/color_link"
                            android:textColorLink="@color/color_link"
                            app:drawableStartCompat="@drawable/ic_link"
                            app:drawableTint="@color/color_link" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/specialties"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/space_3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/stat_published"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.App.Stat" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_stat_published"
                                android:textAppearance="@style/TextAppearance.App.BodySmall" />
                        </LinearLayout>

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="@dimen/border_width"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/stat_downloads"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.App.Stat" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_stat_downloads"
                                android:textAppearance="@style/TextAppearance.App.BodySmall" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.App.ProfileSectionTitle"
                android:text="@string/profile_section_mode" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include
                    android:id="@+id/switch_mode_item"
                    layout="@layout/item_profile_row" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.App.ProfileSectionTitle"
                android:text="@string/profile_group_account" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/linked_methods_item"
                        layout="@layout/item_profile_row" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dividerInsetStart="@dimen/space_12" />

                    <include
                        android:id="@+id/settings_item"
                        layout="@layout/item_profile_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6">

                <include
                    android:id="@+id/sign_out_item"
                    layout="@layout/item_profile_row" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.App.BodySmall" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.aris.templateapp.ui.common.StateView
        android:id="@+id/state"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
