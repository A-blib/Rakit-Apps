<?xml version="1.0" encoding="utf-8"?>
<!--
    Bagian "Foto profil" di Edit profil (pembuat website & provider): avatar bulat di tengah, lalu tombol
    Ganti foto / Hapus. Avatar = lingkaran kuning bercincin (huruf depan nama) dengan foto di atasnya bila ada.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="@dimen/profile_avatar_size"
        android:layout_height="@dimen/profile_avatar_size"
        android:background="@drawable/bg_profile_avatar"
        android:padding="@dimen/profile_avatar_ring">

        <TextView
            android:id="@+id/initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textAppearance="@style/TextAppearance.App.Headline"
            android:textColor="@color/color_on_accent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            style="@style/Widget.App.ProgressIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/change_button"
            style="@style/Widget.App.Button.Outlined.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/avatar_change"
            app:icon="@drawable/ic_image" />

        <Button
            android:id="@+id/remove_button"
            style="@style/Widget.App.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:text="@string/avatar_remove" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:gravity="center_horizontal"
        android:text="@string/avatar_hint"
        android:textAppearance="@style/TextAppearance.App.BodySmall"
        android:textColor="@color/color_muted" />
</LinearLayout>
