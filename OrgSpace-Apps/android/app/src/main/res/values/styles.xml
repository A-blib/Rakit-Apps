<?xml version="1.0" encoding="utf-8"?>
<!--
    Gaya komponen (revisi-fondasi-orgspace.md 7.5). Sebagian besar dipasang otomatis lewat tema (themes.xml),
    jadi layout cukup menulis <Button> / <TextInputLayout> tanpa mengatur warna sendiri.
    Varian lain dipilih dengan style="@style/Widget.App.Button.Outlined", dst.
-->
<resources>

    <!-- Tombol utama: isi biru utama, teks putih, berbentuk pil, tanpa bayangan. -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/selector_button_primary_background</item>
        <item name="android:textColor">@color/selector_button_primary_text</item>
        <item name="iconTint">@color/selector_button_primary_text</item>
        <item name="strokeColor">@color/selector_button_primary_stroke</item>
        <item name="strokeWidth">@dimen/border_width</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="rippleColor">@color/color_primary_ripple</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
    </style>

    <!-- Tombol sekunder: bergaris, teks biru utama, berbentuk pil. -->
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/selector_button_outlined_text</item>
        <item name="iconTint">@color/selector_button_outlined_text</item>
        <item name="strokeColor">@color/color_border_strong</item>
        <item name="strokeWidth">@dimen/border_width</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="rippleColor">@color/color_primary_ripple</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
    </style>

    <!-- Tombol teks / link: warna link, tanpa garis bawah. -->
    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <!-- Material 1.14 memberi tombol teks bentuk pil + garis; dihilangkan agar benar-benar tampil sebagai link. -->
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textColor">@color/color_link</item>
        <item name="iconTint">@color/color_link</item>
        <item name="rippleColor">@color/color_link_tint</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
    </style>

    <!-- Input: kotak putih bergaris, label di atas, fokus = garis biru utama. -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxStrokeWidth">@dimen/border_width</item>
        <item name="boxStrokeWidthFocused">@dimen/border_width_selected</item>
        <item name="boxBackgroundColor">@color/color_surface</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_small</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_small</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_small</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_small</item>
        <item name="hintTextColor">@color/color_primary</item>
        <item name="cursorColor">@color/color_primary</item>
        <item name="android:textColorHint">@color/color_muted</item>
        <item name="endIconTint">@color/color_muted</item>
        <item name="errorTextColor">@color/color_error</item>
        <item name="boxStrokeErrorColor">@color/color_error</item>
        <item name="hintTextAppearance">@style/TextAppearance.App.BodySmall</item>
        <item name="errorTextAppearance">@style/TextAppearance.App.BodySmall</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.App.BodySmall</item>
    </style>

    <!-- Kartu: latar surface, garis 1dp, tanpa bayangan, sudut 16dp. Terpilih: garis 2dp biru (di kode). -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="strokeColor">@color/selector_card_stroke</item>
        <item name="strokeWidth">@dimen/border_width</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/radius_medium</item>
        <item name="checkedIcon">@null</item>
        <item name="rippleColor">@color/color_primary_ripple</item>
    </style>

    <!-- Chip pilihan: bergaris; terpilih = isi biru muda (primary container), tanpa ikon centang. -->
    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/selector_chip_background</item>
        <item name="android:textColor">@color/selector_chip_text</item>
        <item name="chipStrokeColor">@color/selector_chip_stroke</item>
        <item name="chipStrokeWidth">@dimen/border_width</item>
        <item name="chipCornerRadius">@dimen/radius_small</item>
        <item name="chipMinTouchTargetSize">@dimen/touch_target_min</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipSurfaceColor">@android:color/transparent</item>
        <item name="android:textAppearance">@style/TextAppearance.App.BodySmall</item>
    </style>

    <!-- App bar datar: latar layar, garis bawah 1dp, judul teks Plus Jakarta Sans Bold. -->
    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@drawable/bg_app_bar</item>
        <item name="android:minHeight">@dimen/app_bar_height</item>
        <item name="titleTextAppearance">@style/TextAppearance.App.AppBarTitle</item>
        <item name="titleTextColor">@color/color_foreground</item>
        <item name="navigationIconTint">@color/color_foreground</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Badge pil: latar biru muda untuk mode/peran. Sorotan ("Baru", "Segera hadir") memakai Widget.App.Badge.Accent. -->
    <style name="Widget.App.Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:paddingStart">@dimen/space_3</item>
        <item name="android:paddingEnd">@dimen/space_3</item>
        <item name="android:paddingTop">@dimen/space_1</item>
        <item name="android:paddingBottom">@dimen/space_1</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Label</item>
        <item name="android:textColor">@color/color_on_primary_container</item>
    </style>

    <!-- Badge sorotan ("Baru", "Segera hadir"): kuning aksen. -->
    <style name="Widget.App.Badge.Accent">
        <item name="android:background">@drawable/bg_badge_accent</item>
        <item name="android:textColor">@color/color_on_accent</item>
    </style>

    <style name="Widget.App.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/color_primary_container</item>
    </style>

    <!-- Bottom navigation: latar layar, tanpa bayangan; tab aktif biru dengan pil biru muda di belakang ikon.
         Garis atas 1dp dipasang di layout (MaterialDivider). -->
    <style name="Widget.App.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/color_background</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/selector_bottom_nav</item>
        <item name="itemTextColor">@color/selector_bottom_nav</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNavigation.ActiveIndicator</item>
        <item name="itemRippleColor">@color/color_primary_ripple</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.App.NavLabel.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.App.NavLabel</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- Tombol + (buat website): lingkaran biru utama, hanya ikon, tanpa bayangan. -->
    <style name="Widget.App.Button.Create" parent="Widget.App.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="icon">@drawable/ic_add</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>

    <!-- Tombol bergaris ringkas berdua dalam satu baris (bagian "Mulai" di Beranda): teks & ikon lebih kecil
         agar "Pakai template" tidak terlipat di layar 360dp. -->
    <style name="Widget.App.Button.Outlined.Compact">
        <item name="android:paddingStart">@dimen/space_3</item>
        <item name="android:paddingEnd">@dimen/space_3</item>
        <item name="iconSize">@dimen/icon_size_small</item>
        <item name="iconPadding">@dimen/space_2</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button.Small</item>
    </style>

    <!-- Tombol di dalam MaterialButtonToggleGroup (HP/Desktop): terpilih diisi biru muda seperti chip terpilih,
         agar pilihan aktif terlihat jelas. -->
    <style name="Widget.App.Button.Toggle" parent="Widget.App.Button.Outlined.Compact">
        <item name="backgroundTint">@color/selector_chip_background</item>
        <item name="android:textColor">@color/selector_chip_text</item>
        <item name="iconTint">@color/selector_chip_text</item>
        <item name="strokeColor">@color/selector_chip_stroke</item>
    </style>

    <!-- Tombol kecil bergaris untuk dropdown filter (Kategori, Urutkan): ikon panah di kanan teks. -->
    <style name="Widget.App.Button.Dropdown" parent="Widget.App.Button.Outlined">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:paddingStart">@dimen/space_3</item>
        <item name="android:paddingEnd">@dimen/space_2</item>
        <item name="icon">@drawable/ic_expand_more</item>
        <item name="iconGravity">textEnd</item>
        <item name="iconSize">@dimen/icon_size_small</item>
        <item name="iconPadding">@dimen/space_1</item>
        <item name="android:textAppearance">@style/TextAppearance.App.BodySmall</item>
        <item name="android:textColor">@color/color_foreground</item>
    </style>

    <!-- Judul bagian Beranda (mis. "Ringkasan"): Label tebal di kiri, padding seragam. -->
    <style name="Widget.App.SectionTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Label</item>
    </style>

    <!-- Tombol ikon toolbar editor Tandai: area sentuh 48dp, tanpa latar. -->
    <style name="Widget.App.ToolbarIcon" parent="">
        <item name="android:layout_width">@dimen/touch_target_min</item>
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="android:layout_marginHorizontal">@dimen/space_1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- Baris checklist "Sebelum upload": ikon ✓ di kiri, teks biasa. -->
    <style name="Widget.App.ChecklistItem" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_2</item>
        <item name="android:drawableStart">@drawable/ic_check_small</item>
        <item name="android:drawablePadding">@dimen/space_2</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Body</item>
    </style>

    <!-- Contoh kode di artikel Panduan: kotak bergaris tipis, bisa digulir ke samping. Huruf monospace bawaan HP
         dipakai karena kode lebih mudah dibaca dengan lebar huruf yang sama. -->
    <style name="Widget.App.CodeBlock" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_2</item>
        <item name="android:background">@drawable/bg_thumbnail</item>
        <item name="android:padding">@dimen/space_3</item>
        <item name="android:textAppearance">@style/TextAppearance.App.BodySmall</item>
        <item name="android:typeface">monospace</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <style name="Widget.App.Divider" parent="Widget.Material3.MaterialDivider">
        <item name="dividerColor">@color/color_border</item>
        <item name="dividerThickness">@dimen/border_width</item>
    </style>

    <!-- Indikator loading: garis tipis biru utama. -->
    <style name="Widget.App.ProgressIndicator" parent="Widget.Material3.CircularProgressIndicator.Small">
        <item name="indicatorColor">@color/color_primary</item>
        <item name="trackColor">@color/color_border</item>
    </style>

    <!-- Snackbar: latar biru tua (foreground), teks latar, tombol aksi kuning aksen agar menonjol. -->
    <style name="Widget.App.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/color_foreground</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
    </style>

    <style name="Widget.App.Snackbar.Text" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">@color/color_background</item>
        <item name="android:textAppearance">@style/TextAppearance.App.BodySmall</item>
    </style>

    <style name="Widget.App.Snackbar.Button" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/color_accent</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
    </style>

    <!-- Baris daftar (Pengaturan, menu profil): tinggi minimal 56dp, efek sentuh, tanpa garis. -->
    <style name="Widget.App.ListItem" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/list_item_min_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">@dimen/screen_padding_horizontal</item>
        <item name="android:paddingVertical">@dimen/space_3</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Baris daftar sederhana (ikon + teks) sebagai satu TextView: ikon dipasang lewat drawableStart. -->
    <style name="Widget.App.ListItem.Text" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/list_item_min_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/screen_padding_horizontal</item>
        <item name="android:paddingVertical">@dimen/space_3</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:drawablePadding">@dimen/space_4</item>
        <item name="drawableTint">@color/color_foreground</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Body</item>
    </style>

    <!-- Judul grup daftar (mis. "Akun") memakai style Label. -->
    <style name="Widget.App.ListGroupTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">@dimen/screen_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/space_6</item>
        <item name="android:paddingBottom">@dimen/space_2</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Label</item>
    </style>

    <!-- Judul kelompok di atas kartu menu profil (mis. "Akun"): style Label, sejajar tepi kartu. -->
    <style name="Widget.App.ProfileSectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/space_1</item>
        <item name="android:paddingTop">@dimen/space_6</item>
        <item name="android:paddingBottom">@dimen/space_2</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Label</item>
    </style>

    <!-- Checkbox: kotak biru utama. -->
    <style name="Widget.App.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/color_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Body</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <!-- Bottom sheet: latar surface, sudut atas 24dp, tanpa bayangan berwarna. -->
    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet</item>
    </style>

    <style name="Widget.App.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/color_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Large</item>
    </style>

    <!-- Dialog: satu-satunya komponen yang boleh punya elevasi (bagian 9.2). -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Medium</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.Button.Text</item>
    </style>

    <!-- Logo kecil di app bar: sudut 12dp terlalu bulat untuk kotak 28dp. -->
    <style name="ShapeAppearance.App.ExtraSmall" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/radius_extra_small</item>
    </style>

    <style name="ShapeAppearance.App.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/radius_small</item>
    </style>

    <style name="ShapeAppearance.App.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/radius_medium</item>
    </style>

    <style name="ShapeAppearance.App.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/radius_large</item>
    </style>
</resources>
