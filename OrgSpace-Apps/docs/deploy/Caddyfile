# Caddyfile production OrgSpace: VPS hanya menjalankan backend Spring Boot (+ PostgreSQL).
# OrgSpace-Website dan OrgSpace-Hosting (website organisasi + domain milik organisasi) ada di Vercel, jadi tidak di sini.
# Langkah lengkap: docs/deploy/Panduan-Hosting-OrgSpace.docx bab 7. Ringkasnya: salin ke /etc/caddy/Caddyfile, isi
# /etc/caddy/.env (dimuat lewat EnvironmentFile systemd), lalu:
#   sudo caddy validate --config /etc/caddy/Caddyfile --envfile /etc/caddy/.env && sudo systemctl restart caddy
#
# Variabel:
#   API_DOMAIN   domain backend, mis. api.orgspace.app (dipakai app Android, portal web, Hosting, Portal Pengurus)
#
# Backend :8080 hanya mendengar 127.0.0.1; yang terbuka ke internet hanya Caddy (port 80/443).

(keamanan) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$API_DOMAIN} {
	import keamanan
	# /sites/* = jalur lama penyaji website langsung dari backend, tanpa header sandbox Hosting; script template di
	# sana akan berjalan di domain API. /internal/* hanya untuk pemanggilan dari dalam VPS. Keduanya ditutup.
	@tertutup path /sites /sites/* /internal/*
	respond @tertutup 404
	reverse_proxy 127.0.0.1:8080
}
