# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env.
# Tulis nilai tanpa tanda kutip.
DB_URL=jdbc:postgresql://localhost:5432/templateapp
DB_USERNAME=
DB_PASSWORD=
# Minimal 32 byte acak. Buat dengan: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Diisi di Fase 03.
GOOGLE_WEB_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback
APP_DEEP_LINK=templateapp://auth/callback
# Opsional: folder penyimpanan ZIP upload (bawaan: uploads, relatif ke folder backend).
# UPLOAD_STORAGE_DIR=

# Ruang kerja organisasi (revisi-fondasi-orgspace.md 4.1)
ORG_MAX_MEMBERS=30
# Kode undangan sekali pakai, berlaku sekian menit sejak dibuat.
ORG_INVITE_TTL_MINUTES=60
ORG_LOGO_MAX_KB=1024
ORG_LOGO_DIR=./data/org-logos

# Website organisasi yang diterbitkan (alur-publish-website.md 7.1). Di VPS: SITES_DOMAIN={DOMAIN_SITUS}, https.
SITES_DOMAIN=sites.localhost:8081
SITES_URL_SCHEME=http
# Alamat OrgSpace-Hosting. Link website = {SITES_HOSTING_URL}/{slug}. Di VPS: https://orgspace.app
SITES_HOSTING_URL=http://localhost:3001
# Domain kustom: IP publik VPS (record A) dan target CNAME untuk subdomain.
SITES_PUBLIC_IP=
SITES_CUSTOM_TARGET=
SITES_MAX_PER_ORG=5
SITES_MAX_PER_PERSONAL=5

# Website yang diedit di cloud (alur-buat-website-via-template.md 3.1). Semua opsional.
PROJECT_ASSETS_DIR=./data/project-assets
PROJECT_ASSET_MAX_KB=1024
PROJECT_STORAGE_MAX_MB_PER_ORG=300
PROJECT_LOCK_TTL_SECONDS=120

# Portal web OrgSpace (docs/rancangan/portal-web.md). Semua opsional.
PORTAL_ANDROID_DOWNLOAD_URL=
PORTAL_FEEDBACK_DAILY_LIMIT=10
PORTAL_USAGE_FLUSH_SECONDS=60

# Website organisasi di Vercel (project OrgSpace-Hosting). Instruksi DNS untuk domain milik organisasi:
# SITES_PUBLIC_IP=76.76.21.21 dan SITES_CUSTOM_TARGET=cname.vercel-dns.com (nilai yang ditampilkan Vercel).
# Token dibuat sekali di Vercel → Account Settings → Tokens; dipakai untuk mendaftarkan semua domain organisasi.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Isi hanya jika project ada di Team Vercel (Settings → General → Team ID).
VERCEL_TEAM_ID=
# Kunci rahasia bersama dengan OrgSpace-Hosting (isi yang SAMA di env Vercel Hosting). Buat: openssl rand -hex 32
HOSTING_SHARED_KEY=
# Gambar hero & info terbaru landing page (di VPS: /var/lib/orgspace/landing agar ikut backup).
LANDING_IMAGE_DIR=./data/landing
