{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: jalankan (dev)",
      "type": "shell",
      "command": "./mvnw spring-boot:run -Dspring-boot.run.profiles=dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "backend: test",
      "type": "shell",
      "command": "./mvnw test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
