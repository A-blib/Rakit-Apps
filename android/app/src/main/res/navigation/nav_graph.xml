<?xml version="1.0" encoding="utf-8"?>
<!--
    Peta layar app. Setiap <fragment> adalah satu layar; <action> adalah jalur pindah layar.
    popUpTo="@id/nav_graph" + popUpToInclusive="true": semua layar sebelumnya dibuang dari back stack,
    jadi tombol kembali di dashboard menutup app, bukan kembali ke startup/intro.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/startupFragment">

    <!-- Layar awal (animasi pahlawan) yang memilih layar pertama, bagian 6.1. Tujuannya naik dari bawah (slide_up_in). -->
    <fragment
        android:id="@+id/startupFragment"
        android:name="com.aris.templateapp.ui.startup.StartupFragment">
        <action
            android:id="@+id/action_startup_to_intro"
            app:destination="@id/introFragment"
            app:enterAnim="@anim/slide_up_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_startup_to_creator_dashboard"
            app:destination="@id/creatorDashboardFragment"
            app:enterAnim="@anim/slide_up_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_startup_to_provider_dashboard"
            app:destination="@id/providerDashboardFragment"
            app:enterAnim="@anim/slide_up_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_startup_to_role_select"
            app:destination="@id/roleSelectFragment"
            app:enterAnim="@anim/slide_up_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/introFragment"
        android:name="com.aris.templateapp.ui.intro.IntroFragment">
        <action
            android:id="@+id/action_intro_to_creator_dashboard"
            app:destination="@id/creatorDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/creatorDashboardFragment"
        android:name="com.aris.templateapp.ui.creator.CreatorDashboardFragment">
        <action
            android:id="@+id/action_creator_dashboard_to_login"
            app:destination="@id/loginFragment" />
        <!-- Dibaca CreatorDashboardFragment.ARG_PROVIDER_SUSPENDED. -->
        <argument
            android:name="providerSuspended"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

    <!-- Shell Dashboard Provider: 4 tab (Beranda, Upload, Template Anda, Profil) adalah Fragment anak di dalamnya. -->
    <!-- Halaman editor (alur-pembuatan-website.md 6.1). Versi awal "Segera hadir"; argumen title = nama project/template. -->
    <fragment
        android:id="@+id/templateEditorFragment"
        android:name="com.aris.templateapp.ui.editor.ComingSoonEditorFragment$TemplateEditor">
        <argument
            android:name="title"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/customEditorFragment"
        android:name="com.aris.templateapp.ui.editor.ComingSoonEditorFragment$CustomEditor">
        <argument
            android:name="title"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/creatorProfileEditFragment"
        android:name="com.aris.templateapp.ui.creator.CreatorProfileEditFragment" />

    <fragment
        android:id="@+id/providerDashboardFragment"
        android:name="com.aris.templateapp.ui.provider.ProviderDashboardFragment" />

    <!-- Layar lanjutan Dashboard Provider, dibuka di atas shell lewat ProviderNav. -->
    <fragment
        android:id="@+id/templateDetailFragment"
        android:name="com.aris.templateapp.ui.provider.TemplateDetailFragment">
        <argument
            android:name="templateId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/guideFragment"
        android:name="com.aris.templateapp.ui.guide.GuideFragment">
        <!-- Nama enum Guide, mis. "PREPARE_TEMPLATE". -->
        <argument
            android:name="guide"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/providerProfileEditFragment"
        android:name="com.aris.templateapp.ui.provider.ProviderProfileEditFragment" />

    <!-- Onboarding akun baru (bagian 6.6). Pilih peran adalah layar paling bawah, jadi kembali = keluar app. -->
    <fragment
        android:id="@+id/roleSelectFragment"
        android:name="com.aris.templateapp.ui.onboarding.RoleSelectFragment">
        <action
            android:id="@+id/action_role_select_to_creator_form"
            app:destination="@id/creatorFormFragment" />
        <action
            android:id="@+id/action_role_select_to_provider_form"
            app:destination="@id/providerFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/creatorFormFragment"
        android:name="com.aris.templateapp.ui.onboarding.CreatorFormFragment" />

    <!-- Dibuka dari onboarding ATAU dari menu profil "Jadi penyedia template". -->
    <fragment
        android:id="@+id/providerFormFragment"
        android:name="com.aris.templateapp.ui.onboarding.ProviderFormFragment" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.aris.templateapp.ui.settings.SettingsFragment">
        <action
            android:id="@+id/action_settings_to_linked_methods"
            app:destination="@id/linkedMethodsFragment" />
    </fragment>

    <fragment
        android:id="@+id/linkedMethodsFragment"
        android:name="com.aris.templateapp.ui.settings.LinkedMethodsFragment" />

    <!-- Masuk & Daftar. Setelah berhasil, PostLoginNavigator membuka dashboard dan membersihkan back stack. -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.aris.templateapp.ui.auth.LoginFragment">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.aris.templateapp.ui.auth.RegisterFragment">
        <!-- Penyambungan akun lewat email + password: buka layar Masuk baru (yang lama dibuang) dengan linkToken. -->
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Wizard Upload provider (docs/rancangan/alur-fitur-upload.md): layar penuh di atas Dashboard Provider. -->
    <fragment
        android:id="@+id/uploadCheckFragment"
        android:name="com.aris.templateapp.ui.upload.UploadCheckFragment">
        <!-- uri + fileName + fileSize: file baru dipilih. Hanya templateId: membuka hasil/progres pengecekan. -->
        <argument
            android:name="uri"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="fileName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="fileSize"
            android:defaultValue="0L"
            app:argType="long" />
        <argument
            android:name="templateId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/uploadInfoFragment"
        android:name="com.aris.templateapp.ui.upload.UploadInfoFragment">
        <argument
            android:name="templateId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/uploadMarkFragment"
        android:name="com.aris.templateapp.ui.upload.UploadMarkFragment">
        <argument
            android:name="templateId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/uploadTryFragment"
        android:name="com.aris.templateapp.ui.upload.UploadTryFragment">
        <argument
            android:name="templateId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/helpArticleFragment"
        android:name="com.aris.templateapp.ui.upload.HelpArticleFragment">
        <argument
            android:name="code"
            app:argType="string" />
    </fragment>

</navigation>
