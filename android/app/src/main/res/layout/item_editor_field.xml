<?xml version="1.0" encoding="utf-8"?>
<!--
    Satu isian di form editor (alur-buat-website-via-template.md bagian 6.4–6.5): label (+ * jika wajib), petunjuk,
    input sesuai jenis (ditambahkan dari kode), dan peringatan "Masih teks contoh" / kontras rendah.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_4">

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/geist_semibold"
        android:textAppearance="@style/TextAppearance.App.Body" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.App.BodySmall"
        android:textColor="@color/color_muted"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/inputs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:drawablePadding="@dimen/space_1"
        android:gravity="center_vertical"
        android:textAppearance="@style/TextAppearance.App.BodySmall"
        android:textColor="@color/color_warning"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_warning"
        app:drawableTint="@color/color_warning" />
</LinearLayout>
