<?xml version="1.0" encoding="utf-8"?>
<!--
    Tab Profil pembuat website = akun pribadi (alur-pembuatan-website.md bagian 8). Dua versi dalam satu layout:
    tamu (ajakan masuk) dan user login (kepala profil, ruang kerja saya, menu). Data organisasi ada di Profil
    organisasi, bukan di sini.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_6">

        <!-- TAMU -->
        <LinearLayout
            android:id="@+id/guest_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/space_6"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_guest_title"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="@string/profile_guest_body"
                        android:textAppearance="@style/TextAppearance.App.BodySmall" />

                    <Button
                        android:id="@+id/guest_sign_in_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/action_sign_in" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

</LinearLayout>

        <!-- USER LOGIN -->
        <LinearLayout
            android:id="@+id/user_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                android:paddingTop="@dimen/space_6">

                <TextView
                    android:id="@+id/avatar"
                    android:layout_width="@dimen/space_12"
                    android:layout_height="@dimen/space_12"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    android:textColor="@color/color_on_accent" />

                <TextView
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:textAppearance="@style/TextAppearance.App.Headline" />

                <TextView
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:textAppearance="@style/TextAppearance.App.BodySmall" />

                <TextView
                    style="@style/Widget.App.Badge"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/profile_badge_creator" />

                <Button
                    android:id="@+id/edit_button"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/profile_edit_name"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <!-- Ketuk satu ruang kerja = pindah ruang kerja aktif (sama seperti pemilih di app bar). -->
            <TextView
                style="@style/Widget.App.ListGroupTitle"
                android:text="@string/profile_group_workspaces" />

            <LinearLayout
                android:id="@+id/workspace_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Widget.App.ListGroupTitle"
                android:text="@string/profile_group_actions" />

            <TextView
                android:id="@+id/switch_mode_item"
                style="@style/Widget.App.ListItem.Text"
                android:text="@string/profile_switch_to_provider"
                app:drawableStartCompat="@drawable/ic_swap_horiz" />

            <TextView
                android:id="@+id/become_provider_item"
                style="@style/Widget.App.ListItem.Text"
                android:text="@string/profile_become_provider"
                app:drawableStartCompat="@drawable/ic_storefront" />
        </LinearLayout>

        <!-- Untuk tamu maupun user login -->
        <TextView
            android:id="@+id/settings_item"
            style="@style/Widget.App.ListItem.Text"
            android:text="@string/profile_settings"
            app:drawableStartCompat="@drawable/ic_settings" />

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/sign_out_divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/sign_out_item"
            style="@style/Widget.App.ListItem.Text"
            android:text="@string/profile_sign_out"
            app:drawableStartCompat="@drawable/ic_logout" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
