<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet tombol + (alur-pembuatan-website.md bagian 2): Pakai template / Custom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/space_2"
    android:paddingBottom="@dimen/space_6">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_4"
        android:text="@string/create_sheet_title"
        android:textAppearance="@style/TextAppearance.App.Title" />

    <include
        android:id="@+id/option_template"
        layout="@layout/view_start_option" />

    <include
        android:id="@+id/option_custom"
        layout="@layout/view_start_option"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2" />
</LinearLayout>
