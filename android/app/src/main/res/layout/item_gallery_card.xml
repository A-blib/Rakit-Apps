<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu template kecil "Template untuk anda" di Beranda (digeser ke samping). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/template_card_small_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_2"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/thumbnail_height_card"
            android:background="@color/color_surface_subtle">

            <ImageView
                android:layout_width="@dimen/space_8"
                android:layout_height="@dimen/space_8"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_web"
                app:tint="@color/color_muted" />
        </FrameLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_3">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lines="2"
                android:textAppearance="@style/TextAppearance.App.Body" />

            <TextView
                android:id="@+id/creator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.BodySmall" />

            <TextView
                android:id="@+id/category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Label" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
