<?xml version="1.0" encoding="utf-8"?>
<!--
    Langkah 4 Upload: Tandai bagian (alur-fitur-upload.md bagian 7). Tiga zona (bagian 3.3):
    atas = navigasi (✕, langkah, halaman, HP/Desktop, penghitung), tengah = slide (WebView), bawah = alat (saran,
    toolbar, strip slide, Simpan/Coba). host_frame juga menampung WebView tersembunyi untuk memindai halaman lain.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/host_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UselessParent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_background"
        android:orientation="vertical">

        <include
            android:id="@+id/header"
            layout="@layout/view_wizard_header" />

        <!-- Zona atas: halaman, tampilan, penghitung -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/space_2">

            <Button
                android:id="@+id/page_button"
                style="@style/Widget.App.Button.Dropdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/cd_page_select"
                android:ellipsize="end"
                android:maxLines="1" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/view_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/view_mobile"
                    style="@style/Widget.App.Button.Toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upload_view_mobile" />

                <Button
                    android:id="@+id/view_desktop"
                    style="@style/Widget.App.Button.Toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upload_view_desktop" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingVertical="@dimen/space_2">

            <TextView
                android:id="@+id/slide_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Label" />

            <TextView
                android:id="@+id/counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.App.Label" />
        </LinearLayout>

        <!-- Zona tengah: satu section ditampilkan seperti slide -->
        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/color_surface_subtle">

            <FrameLayout
                android:id="@+id/web_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="top"
                android:background="@drawable/bg_thumbnail"
                android:padding="@dimen/border_width" />

            <com.aris.templateapp.ui.common.StateView
                android:id="@+id/state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/color_background" />

            <!-- Tur singkat pertama kali -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tour_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="@dimen/space_3"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:id="@+id/tour_count"
                        style="@style/Widget.App.SectionTitle" />

                    <TextView
                        android:id="@+id/tour_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:textAppearance="@style/TextAppearance.App.Body" />

                    <Button
                        android:id="@+id/tour_next"
                        style="@style/Widget.App.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="@string/mark_tour_next" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Breadcrumb elemen terpilih -->
        <TextView
            android:id="@+id/breadcrumb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:fontFamily="@font/geist_mono_regular"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/color_muted"
            android:visibility="gone" />

        <!-- Saran otomatis / peringatan teks mirip (satu baris kecil, tidak menutupi slide) -->
        <LinearLayout
            android:id="@+id/hint_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingEnd="@dimen/space_2"
            android:visibility="gone">

            <TextView
                android:id="@+id/hint_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.App.BodySmall" />

            <Button
                android:id="@+id/hint_action"
                style="@style/Widget.App.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Toolbar: undo, redo, daftar elemen, panel isian, section, bantuan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton android:id="@+id/undo_button" style="@style/Widget.App.ToolbarIcon" android:contentDescription="@string/cd_undo" android:src="@drawable/ic_undo" />
            <ImageButton android:id="@+id/redo_button" style="@style/Widget.App.ToolbarIcon" android:contentDescription="@string/cd_redo" android:src="@drawable/ic_redo" />
            <ImageButton android:id="@+id/elements_button" style="@style/Widget.App.ToolbarIcon" android:contentDescription="@string/cd_element_list" android:src="@drawable/ic_list" />
            <ImageButton android:id="@+id/fields_button" style="@style/Widget.App.ToolbarIcon" android:contentDescription="@string/cd_fields_panel" android:src="@drawable/ic_fields" />
            <ImageButton android:id="@+id/sections_button" style="@style/Widget.App.ToolbarIcon" android:contentDescription="@string/cd_sections" android:src="@drawable/ic_sections" />
            <ImageButton android:id="@+id/help_button" style="@style/Widget.App.ToolbarIcon" android:contentDescription="@string/cd_mark_help" android:src="@drawable/ic_help" />
        </LinearLayout>

        <!-- Strip slide: setiap section + status ✓ (ada tandaan) / • (sedang dibuka) -->
        <HorizontalScrollView
            android:id="@+id/strip_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                app:chipSpacingHorizontal="@dimen/space_2"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2" />

        <TextView
            android:id="@+id/unsaved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_mono_regular"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.App.BodySmall" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingVertical="@dimen/space_2">

            <Button
                android:id="@+id/save_button"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mark_save" />

            <Button
                android:id="@+id/try_button"
                style="@style/Widget.App.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:text="@string/mark_try"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
