<?xml version="1.0" encoding="utf-8"?>
<!-- Pilihan ruang kerja (revisi-fondasi-orgspace.md bagian 5): buat organisasi, gabung lewat kode, atau pribadi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/space_8">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/workspace_choice_title"
                android:textAppearance="@style/TextAppearance.App.Display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/workspace_choice_subtitle"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/color_muted" />

            <include
                android:id="@+id/create_card"
                layout="@layout/item_choice_card" />

            <include
                android:id="@+id/join_card"
                layout="@layout/item_choice_card" />

            <include
                android:id="@+id/personal_card"
                layout="@layout/item_choice_card" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
