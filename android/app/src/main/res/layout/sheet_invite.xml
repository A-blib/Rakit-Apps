<?xml version="1.0" encoding="utf-8"?>
<!-- Undang anggota (F1–F3): pilih peran → buat kode → kode besar + Salin + Bagikan. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/space_2"
    android:paddingBottom="@dimen/space_6">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/members_invite"
        android:textAppearance="@style/TextAppearance.App.Title" />

    <LinearLayout
        android:id="@+id/choose_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/invite_role_label"
            android:textAppearance="@style/TextAppearance.App.Label" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/role_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            app:checkedChip="@id/role_editor"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/role_editor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/role_editor" />

            <com.google.android.material.chip.Chip
                android:id="@+id/role_admin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/role_admin" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/role_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/invite_role_editor_desc"
            android:textAppearance="@style/TextAppearance.App.BodySmall" />

        <Button
            android:id="@+id/create_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:text="@string/invite_create" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/code_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/invite_code_label"
            android:textAppearance="@style/TextAppearance.App.Label" />

        <TextView
            android:id="@+id/code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:background="@drawable/bg_thumbnail"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:padding="@dimen/space_4"
            android:textAppearance="@style/TextAppearance.App.Display"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/valid_until"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.App.BodySmall" />

        <!-- Dua tombol sejajar (Salin bergaris, Bagikan utama), sama seperti pasangan tombol lain di app. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:orientation="horizontal"
            tools:ignore="ButtonStyle">

            <Button
                android:id="@+id/copy_button"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_2"
                android:layout_weight="1"
                android:text="@string/invite_copy" />

            <Button
                android:id="@+id/share_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:text="@string/invite_share"
                app:icon="@drawable/ic_share" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
