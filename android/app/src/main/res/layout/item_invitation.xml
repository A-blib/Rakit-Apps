<?xml version="1.0" encoding="utf-8"?>
<!-- Undangan aktif: peran + masa berlaku, tombol Cabut. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_item_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingEnd="@dimen/space_2">

    <ImageView
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_key" />

    <TextView
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_4"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.App.Body" />

    <Button
        android:id="@+id/revoke_button"
        style="@style/Widget.App.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/invitation_revoke" />
</LinearLayout>
