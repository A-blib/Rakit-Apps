<?xml version="1.0" encoding="utf-8"?>
<!--
    Langkah 5 Upload: Coba sebagai pengguna (alur-fitur-upload.md bagian 8). Zona atas = navigasi, tengah = preview
    yang langsung berubah saat form diisi, bawah = form per section berupa bottom sheet yang bisa ditarik.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="@dimen/try_sheet_peek">

        <include
            android:id="@+id/header"
            layout="@layout/view_wizard_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingVertical="@dimen/space_2">

            <Button
                android:id="@+id/page_button"
                style="@style/Widget.App.Button.Dropdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/cd_page_select"
                android:ellipsize="end"
                android:maxLines="1" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/view_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/view_mobile"
                    style="@style/Widget.App.Button.Outlined.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upload_view_mobile" />

                <Button
                    android:id="@+id/view_desktop"
                    style="@style/Widget.App.Button.Outlined.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upload_view_desktop" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/web_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_thumbnail"
            android:padding="@dimen/border_width">

            <com.aris.templateapp.ui.common.StateView
                android:id="@+id/state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/color_background" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingVertical="@dimen/space_2">

            <Button
                android:id="@+id/long_button"
                style="@style/Widget.App.Button.Outlined.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/try_long_content" />

            <Button
                android:id="@+id/reset_button"
                style="@style/Widget.App.Button.Outlined.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:text="@string/try_reset" />
        </LinearLayout>
    </LinearLayout>

    <!-- Form isian: bottom sheet yang bisa ditarik naik/turun -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sheet_top"
        android:contentDescription="@string/cd_try_panel"
        android:orientation="vertical"
        app:behavior_fitToContents="false"
        app:behavior_halfExpandedRatio="0.55"
        app:behavior_peekHeight="@dimen/try_sheet_peek"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/section_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingVertical="@dimen/space_2">

            <TextView
                android:id="@+id/need_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="@color/color_warning"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/back_mark_button"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/try_back_mark"
                    app:icon="@drawable/ic_arrow_back" />

                <Button
                    android:id="@+id/next_button"
                    style="@style/Widget.App.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_weight="1"
                    android:text="@string/try_next_send"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="textEnd" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                android:paddingBottom="@dimen/space_8" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
