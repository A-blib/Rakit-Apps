<?xml version="1.0" encoding="utf-8"?>
<!-- Pilih peran (bagian 9.4): judul, dua kartu besar bergaris (judul, deskripsi, panah), catatan kecil. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingVertical="@dimen/space_12">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/role_select_title"
            android:textAppearance="@style/TextAppearance.App.Display" />

        <include
            android:id="@+id/creator_card_content"
            layout="@layout/item_role_card_creator" />

        <include
            android:id="@+id/provider_card_content"
            layout="@layout/item_role_card_provider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/role_select_note"
            android:textAppearance="@style/TextAppearance.App.BodySmall" />
    </LinearLayout>
</ScrollView>
