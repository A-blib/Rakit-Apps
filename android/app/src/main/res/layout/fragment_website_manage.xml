<?xml version="1.0" encoding="utf-8"?>
<!--
    Halaman kelola website (alur-pembuatan-website.md bagian 5): kepala (thumbnail, status, alamat, Edit tampilan,
    Terbitkan / Minta diterbitkan), lalu bagian Ringkasan, Riwayat versi, Domain, Pengaturan situs, dan bagian v2/v3
    yang masih "Segera hadir". Menu ⋮ di app bar: Ganti nama · Duplikat · Export ZIP · Hapus.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/screen_padding_horizontal"
                    android:paddingTop="@dimen/space_4">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/thumbnail_size_large">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_thumbnail">

                            <ImageView
                                android:layout_width="@dimen/space_12"
                                android:layout_height="@dimen/space_12"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_web"
                                app:tint="@color/color_primary" />

                            <ImageView
                                android:id="@+id/thumbnail"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.App.Headline" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/status_badge"
                            style="@style/Widget.App.Badge" />

                        <TextView
                            android:id="@+id/address"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_2"
                            android:layout_weight="1"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:textAppearance="@style/TextAppearance.App.BodySmall" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/changed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="@string/website_changed"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:textColor="@color/color_warning"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/updated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:textAppearance="@style/TextAppearance.App.BodySmall" />

                    <TextView
                        android:id="@+id/lock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:drawablePadding="@dimen/space_1"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:textColor="@color/color_primary"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_lock_small"
                        app:drawableTint="@color/color_primary" />

                    <com.aris.templateapp.ui.common.StatusBannerView
                        android:id="@+id/banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:visibility="gone" />

                    <!-- Bertumpuk, bukan berdampingan: "Terbitkan pertama kali" terlalu panjang untuk setengah layar 360dp. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/publish_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        app:icon="@drawable/ic_public"
                        app:iconGravity="textStart" />

                    <Button
                        android:id="@+id/edit_button"
                        style="@style/Widget.App.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/website_edit_appearance"
                        app:icon="@drawable/ic_edit"
                        app:iconGravity="textStart" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4" />

                <include
                    android:id="@+id/summary_item"
                    layout="@layout/item_menu_row" />

                <include
                    android:id="@+id/versions_item"
                    layout="@layout/item_menu_row" />

                <include
                    android:id="@+id/domain_item"
                    layout="@layout/item_menu_row" />

                <include
                    android:id="@+id/settings_item"
                    layout="@layout/item_menu_row" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/content_item"
                    layout="@layout/item_menu_row" />

                <include
                    android:id="@+id/stats_item"
                    layout="@layout/item_menu_row" />

                <include
                    android:id="@+id/inbox_item"
                    layout="@layout/item_menu_row" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.aris.templateapp.ui.common.StateView
            android:id="@+id/state_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
