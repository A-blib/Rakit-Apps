<?xml version="1.0" encoding="utf-8"?>
<!--
    Baris serbaguna di dalam kartu Beranda (Perlu tindakan, checklist, panduan): ikon, judul + keterangan,
    titik "baru", dan panah. Bagian yang tidak dipakai disembunyikan dari kode.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    tools:ignore="Overdraw"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_item_min_height"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_4"
    android:paddingVertical="@dimen/space_3">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/icon_size_small"
        android:layout_height="@dimen/icon_size_small"
        android:layout_marginEnd="@dimen/space_3"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Body" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/new_dot"
        android:layout_width="@dimen/new_dot_size"
        android:layout_height="@dimen/new_dot_size"
        android:layout_marginStart="@dimen/space_2"
        android:background="@drawable/bg_new_dot"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/chevron"
        android:layout_width="@dimen/icon_size_small"
        android:layout_height="@dimen/icon_size_small"
        android:layout_marginStart="@dimen/space_2"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/color_muted" />
</LinearLayout>
