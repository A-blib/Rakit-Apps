<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Layar awal (saat masuk app): animasi pahlawan selalu tampil minimal selama ini (permintaan Aris).
        Satu putaran terbang = 4000 ms.
    -->
    <integer name="loading_min_duration_ms">2000</integer>
    <!--
        Loading di dalam app (StateView): proses yang selesai sebelum jeda ini tidak diberi animasi sama sekali
        (permintaan Aris). Jika lebih lama, animasi tampil minimal loading_min_visible_ms agar tidak berkedip.
    -->
    <integer name="loading_show_delay_ms">600</integer>
    <integer name="loading_min_visible_ms">1000</integer>
    <!-- Lama isi layar / dashboard naik dari bawah setelah pahlawan melaju ke kanan. -->
    <integer name="slide_up_duration_ms">700</integer>
</resources>
