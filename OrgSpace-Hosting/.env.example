# Backend Spring Boot API URL
BACKEND_API_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Domain publik hosting
NEXT_PUBLIC_HOSTING_DOMAIN=orgspace.app
PORT=3001

# URL Portal Utama (OrgSpace-Website) - diarahkan saat root hosting diakses
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000

# Kunci rahasia bersama dengan backend (HOSTING_SHARED_KEY di backend), agar IP asli pengunjung formulir dipercaya
# saat Hosting di Vercel. Kosongkan di laptop.
HOSTING_SHARED_KEY=
